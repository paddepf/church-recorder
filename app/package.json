{
  "name": "church-recorder",
  "version": "1.0.0",
  "description": "Aufnahmesoftware für Gottesdienste mit ChurchTools-Ablaufplan, Markern, lokaler Transkription und Netzwerksteuerung",
  "main": "src/main/main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:tools": "electron . --dev --devtools",
    "dist": "electron-builder --win",
    "publish": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac",
    "publish:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "electron-updater": "^6.3.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.gemeinde.churchrecorder",
    "productName": "ChurchRecorder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ChurchRecorder"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ChurchRecorder nimmt über den gewählten Audioeingang den Gottesdienst auf.",
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "title": "ChurchRecorder ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "paddepf",
        "repo": "church-recorder",
        "private": false,
        "releaseType": "release"
      }
    ]
  }
}
